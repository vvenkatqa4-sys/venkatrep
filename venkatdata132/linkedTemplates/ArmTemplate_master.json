			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'link_adls'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://venkat123acc.dfs.core.windows.net/"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://venkatkeyvault.vault.azure.net/"
		},
